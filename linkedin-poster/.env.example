# Port the Node service binds to (Caddy reverse-proxies to this on the server)
PORT=3000

# LinkedIn OAuth credentials — set in Phase 2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://poster.thetrustsequence.com/auth/callback

# API key Cowork uses to call this service — set in Phase 5
API_KEY=

# LinkedIn API version (override only if 202601 stops being supported)
# LINKEDIN_VERSION=202601

# First-comment retry tuning (defaults shown). LinkedIn's activity URN is
# eventually-consistent — a 1–30s window can occur where the share URN
# exists but the comment endpoint returns 404. We retry only on that
# specific error with exponential backoff.
# COMMENT_RETRY_MAX_ATTEMPTS=6
# COMMENT_RETRY_INITIAL_DELAY_MS=1500
# COMMENT_RETRY_BACKOFF_MULTIPLIER=2.0
