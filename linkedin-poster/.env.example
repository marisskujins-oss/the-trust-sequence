# Port the Node service binds to (Caddy reverse-proxies to this on the server)
PORT=3000

# LinkedIn OAuth credentials — set in Phase 2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://poster.thetrustsequence.com/auth/callback

# API key Cowork uses to call this service — set in Phase 5
API_KEY=
